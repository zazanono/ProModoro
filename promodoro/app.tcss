Screen {
    background: #141619;
    color: #e7e5e2;
}
#page { height: 1fr; align-horizontal: center; }
#workspace { width: 76; max-width: 100%; height: auto; margin: 2 0; padding: 0 2; }
#masthead { height: 3; align: center middle; margin: 1 0; }
#brand { width: 100%; text-align: center; color: #f1eae2; text-style: bold; }
#timer-card {
    height: auto;
    padding: 1 3;
    border: round #b9655f;
    background: #282023;
}
#phases { height: 1; align: center middle; margin-top: 1; }
Button {
    min-width: 8;
    height: 3;
    border: none;
    background: transparent;
    color: #c5c0c0;
    text-style: none;
}
Button:hover { background: transparent; text-style: underline; }
Button:focus { text-style: bold underline; }
#phases Button { width: auto; min-width: 0; height: 1; margin: 0 3; padding: 0 1; }
#phases .selected { color: #ec9d91; text-style: bold; }
#countdown { width: 100%; height: 3; margin: 1 0; text-align: center; color: #fff1e9; }
#progress { height: 1; text-align: center; color: #ec9d91; }
#timing-detail { text-align: center; color: #aaa2a3; height: 1; margin-top: 1; }
#controls { align: center middle; height: 1; margin: 1 0; }
#controls Button { width: auto; min-width: 0; height: 1; margin: 0 1; padding: 0 1; }
#controls #toggle { width: 10; min-width: 10; }
#toggle { color: #edaa9e; text-style: bold; }
#toggle:hover { background: transparent; text-style: bold underline; }
#cycle { text-align: center; color: #c8a6a2; height: 1; }
#bottom-row { height: 3; align: left middle; margin-top: 1; }
#up-next { width: 1fr; height: 3; content-align: left middle; color: #9a9da4; }
#settings { color: #c7c9ce; }
#notice { height: auto; min-height: 1; color: #b4b6be; margin-top: 1; }
#notice.completion {
    color: #fff1e9;
    background: #34302b;
    text-style: bold;
    border-left: thick #edaa9e;
    padding: 0 1;
}
#command { margin-top: 1; background: #1e2025; border: tall #737b88; }
Footer { background: #1e2025; }
.short #timer-card { background: #192b2b; border: round #569d96; }
.short #phases .selected { color: #91c9b5; }
.short #progress, .short #cycle { color: #91c9b5; }
.short #toggle { color: #91c9b5; }
.short #countdown { color: #d6f1e5; }
.long #timer-card { background: #1e293b; border: round #648dbd; }
.long #phases .selected { color: #a0bfea; }
.long #progress, .long #cycle { color: #a0bfea; }
.long #toggle { color: #a0bfea; }
.long #countdown { color: #e0eaff; }
.compact #workspace { margin: 0; }
.compact #masthead { height: 2; margin: 1 0 0 0; }
.compact #timer-card { padding: 0 2; }
.compact #notice { margin-top: 0; }
.narrow #workspace { padding: 0 1; }
.narrow #timer-card { padding-left: 1; padding-right: 1; }
.narrow #phases Button { margin: 0 1; }
.narrow #controls Button { margin: 0; }
SettingsScreen { align: center middle; background: #000000 65%; }
#settings-dialog {
    width: 62;
    max-width: 95%;
    height: auto;
    max-height: 95%;
    background: #22262e;
    border: round #8d99ad;
    padding: 1 2;
}
#settings-title { text-style: bold; margin-bottom: 1; }
#settings-dialog Label { margin-top: 1; }
#settings-dialog Input { background: #181c23; border: tall #677187; }
#settings-dialog Input:focus { border: tall #edaa9e; }
#settings-error { height: auto; color: #ffaca1; }
#settings-dialog Checkbox { width: 100%; height: auto; background: transparent; }
.dialog-actions { height: 3; align: right middle; margin-top: 1; }
#save { background: #edaa9e; color: #282023; margin-left: 2; }
.compact #settings-dialog { padding: 0 2; }
.compact #settings-dialog Label { margin-top: 0; }
.compact .dialog-actions { margin-top: 0; }
